APP_NAME=FreePour
PUBLIC_DOMAIN=freepour.tv
NODE_ENV=production
WEB_PORT=3000
API_PORT=4000
POSTGRES_DB=freepour
POSTGRES_USER=freepour
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://freepour:replace-with-a-long-random-password@postgres:5432/freepour
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-first-start
PRIZES_ENABLED=false
VITE_API_URL=/api
VITE_SOCKET_URL=/

